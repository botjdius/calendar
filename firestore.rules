rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isInstructor() {
      return signedIn() && userDoc().role == 'instructor';
    }
    function isStudent() {
      return signedIn() && userDoc().role == 'student';
    }
    function myStudentId() {
      return userDoc().studentId;
    }

    match /joinCodes/{code} {
      allow read: if true;
      allow write: if isInstructor();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isInstructor());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isInstructor() || request.auth.uid == uid;
    }

    match /students/{id} {
      allow read: if isInstructor() || (isStudent() && (resource.data.id == myStudentId() || resource.data.linkedUid == request.auth.uid));
      allow create, delete: if isInstructor();
      allow update: if isInstructor() || (isStudent() && (resource.data.id == myStudentId() || resource.data.linkedUid == request.auth.uid));
    }

    match /closures/{id} {
      allow read: if signedIn();
      allow write: if isInstructor();
    }

    match /openSlots/{id} {
      allow read: if signedIn();
      allow write: if isInstructor();
    }

    match /makeupRequests/{id} {
      allow read: if isInstructor() || (isStudent() && resource.data.studentId == myStudentId());
      allow create: if isStudent() && request.resource.data.studentId == myStudentId();
      allow update, delete: if isInstructor();
    }

    match /studio/{doc} {
      allow read: if signedIn();
      allow write: if isInstructor();
    }
  }
}
