    "expo": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.11",
    "eas-cli": "^25.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --lan",
    "hub": "node server/hub.mjs",
    "phone": "node server/hub.mjs",
    "test:schedule": "node server/schedule.test.mjs",
    "test:checklist": "node scripts/test-lesson-checklist.mjs",
    "test:monthly-goals": "node scripts/test-monthly-goals.mjs",
    "dev": "node server/hub.mjs & expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --lan",
    "export:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && cp dist/index.html dist/200.html && npx surge dist jyangjyang.surge.sh",
    "seed:cloud": "node scripts/seed-cloud.mjs",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:all": "eas build --platform all --profile preview",
    "deploy:ota": "eas update --channel production --environment production --message \"쟝쟝 production OTA\"",
    "deploy:ota:production": "eas update --channel production --environment production --message \"쟝쟝 production OTA\"",
    "deploy:ota:staging": "eas update --channel preview --environment preview --message \"쟝쟝 staging OTA\""
  },
  "private": true
}
