{
  "expo": {
    "name": "쟝쟝",
    "slug": "jyang-jyang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "jyangjyang",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EDE3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jyangjyang.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "같은 와이파이의 맥 허브와 레슨 자료를 주고받기 위해 사용합니다."
      }
    },
    "android": {
      "package": "com.jyangjyang.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/13b839d2-4756-465a-b523-1c952b8907ef"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13b839d2-4756-465a-b523-1c952b8907ef"
      }
    }
  }
}
